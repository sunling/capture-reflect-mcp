{
  "name": "log-reflect-mcp",
  "version": "0.3.0",
  "description": "An MCP server for capturing and retrieving records in a log-reflect-practice repository.",
  "type": "module",
  "bin": {
    "log-reflect-mcp": "dist/src/server.js"
  },
  "files": [
    "dist",
    ".codex-plugin",
    ".mcp.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "start:stdio": "node dist/src/server.js",
    "start:http": "node dist/src/http.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "private": false
}
