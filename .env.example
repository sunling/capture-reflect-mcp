# Storage backend: local or github.
RECORDS_STORAGE=local

# Local storage: optional absolute path to a repository that follows the
# record-reflect-practice structure. For backward compatibility, an empty value
# keeps using ~/.log-reflect/records.
RECORDS_REPO_PATH=

# GitHub storage: target repository, fine-grained token, and branch.
# The token needs Contents: Read and write for this repository only.
RECORDS_GITHUB_REPOSITORY=
RECORDS_GITHUB_TOKEN=
RECORDS_GITHUB_BRANCH=main

# Optional IANA time zone used when a tool call omits the date.
# Example: America/Los_Angeles
RECORDS_TIME_ZONE=

# The HTTP server binds to localhost by default for ChatGPT Secure MCP Tunnel.
MCP_HOST=127.0.0.1
MCP_PORT=3000
