# Absolute path to a repository that follows the log-reflect-practice structure.
RECORDS_REPO_PATH=/absolute/path/to/log-reflect-practice

# Optional IANA time zone used when a tool call omits the date.
# Example: America/Los_Angeles
RECORDS_TIME_ZONE=

# The HTTP server binds to localhost by default for ChatGPT Secure MCP Tunnel.
MCP_HOST=127.0.0.1
MCP_PORT=3000
